/file/set-tui-version "21.1"

; A Make Wing
; 1. IMPORT AILERON MESH todo:parameter (name)
(cx-gui-do cx-activate-item "MenuBar*ReadSubMenu*Mesh...")
(cx-gui-do cx-set-file-dialog-entries "Select File" '( "|INPUT_NAME_AILERON|") "All Files (*)")

; 2. MIRROR AILERON
(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Domain)*Table1*Table3(Mesh)*PushButton6(Scale)")
(cx-gui-do cx-set-toggle-button2 "Scale Mesh*Table1*Table2(Scaling)*ToggleBox1*Specify Scaling Factors" #t)
(cx-gui-do cx-activate-item "Scale Mesh*Table1*Table2(Scaling)*ToggleBox1*Specify Scaling Factors")
(cx-gui-do cx-set-real-entry-list "Scale Mesh*Table1*Table2(Scaling)*Frame3(Scaling Factors)*RealEntry2(Y)" '( -1))
(cx-gui-do cx-activate-item "Scale Mesh*Table1*Table2(Scaling)*PushButton4(Scale)")
(cx-gui-do cx-activate-item "Scale Mesh*PanelButtons*PushButton1(Close)")

; 3. DEFLECT AILERON todo: parameter
(cx-gui-do cx-activate-item "Ribbon*Frame1*Frame2(Domain)*Table1*Table3(Mesh)*PushButton7(Transform)")
(cx-gui-do cx-activate-item "MenuBar*PopupMenuScaleTransform*Rotate...")
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*RealEntry1(Rotation Angle)" '(|DELTA_A|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame2(Rotation Origin)*RealEntry1(X)" '(|AILERON_RIGHT_ORIGIN_X|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame2(Rotation Origin)*RealEntry2(Y)" '(|AILERON_RIGHT_ORIGIN_Y|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame2(Rotation Origin)*RealEntry3(Z)" '(|AILERON_RIGHT_ORIGIN_Z|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame3(Rotation Axis)*RealEntry1(X)" '(|AILERON_RIGHT_AXIS_X|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame3(Rotation Axis)*RealEntry2(Y)" '(|AILERON_RIGHT_AXIS_Y|))
(cx-gui-do cx-set-real-entry-list "Rotate Mesh*Table1*Frame3(Rotation Axis)*RealEntry3(Z)" '(|AILERON_RIGHT_AXIS_Z|))
(cx-gui-do cx-activate-item "Rotate Mesh*PanelButtons*PushButton1(OK)")
(cx-gui-do cx-activate-item "Rotate Mesh*PanelButtons*PushButton2(Cancel)")

